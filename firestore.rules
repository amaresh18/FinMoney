rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /identity_registry/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /loan_inbox_by_phone/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /chits/{chitId} {
      allow read, write: if request.auth != null;
    }
    match /loans/{loanId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    match /debit_items/{debitId} {
      allow read, write: if request.auth != null;
    }
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }
    match /income_records/{incomeId} {
      allow read, write: if request.auth != null;
    }
    match /incomes/{incomeId} {
      allow read, write: if request.auth != null;
    }
    match /salary_records/{recordId} {
      allow read, write: if request.auth != null;
    }
    match /custom_categories/{categoryId} {
      allow read, write: if request.auth != null;
    }
    match /monthly_reconciliations/{recId} {
      allow read, write: if request.auth != null;
    }
    match /bank_transactions/{txId} {
      allow read, write: if request.auth != null;
    }
  }
}
